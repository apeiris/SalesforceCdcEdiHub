<pdfMap client="IrisSystems" document="PurchaseOrder">
	<boundingBoxes type="container" nodeName="PurchaseOrder">
		<boundingBox type ="earMarked" nodeName="Buyer" name="1" box="36,601,269,54" parent="parties"/>
		<boundingBox type ="earMarked" nodeName="Supplier" name="2" box="306,601,269,54" parent="parties"/>
		<boundingBox type ="earMarked" nodeName="PODetails" name="3" box="36,547,269,18" parent="PurchaseOrder"/>
		
		
		<!--(new Rectangle(36, 601, 269, 54), "1"),(new Rectangle(306, 601, 269, 54), "2")-->

		</earMarked>
		<boundingBox index="1"   action="process"   content="Parties" >
			<table>
				<columns type="input">
					<column name="Buyer:">
						<row index="1" label="name" operation="none"></row>
						<row index="2" label="address" operation="split" seperators=","  >
							<outputColumns>
								<column label="streetAddress"></column>
								<column label="city"></column>
								<column label="postalCode"></column>
								<column label="country"></column>
							</outputColumns>
						</row>
						<row index="2" label="contact" operation="split" seperators="|"  >
							<outputColumns>
								<column label="phone"></column>
								<column label="email"></column>
							</outputColumns>
						</row>
					</column>
				</columns>
			</table>
		</boundingBox>
		<boundingBox index="2"   action="process"   content="Parties" >
			<table>
				<columns type="input">
					<column name="Supplier">
						<row index="1" label="name" operation="none"></row>
						<row index="2" label="address" operation="split" seperators=","  >
							<outputColumns>
								<column label="streetAddress"></column>
								<column label="city"></column>
								<column label="postalCode"></column>
								<column label="country"></column>
							</outputColumns>
						</row>
						<row index="2" label="contact" operation="split" seperators="|"  >
							<outputColumns>
								<column label="phone"></column>
								<column label="email"></column>
							</outputColumns>
						</row>
					</column>
				</columns>
			</table>
		</boundingBox>
		<boundingBox index="3"   action="ignore"   content="Parties" />
		<boundingBox index="4"   action="ignore"   content="Parties" />
	</boundingBoxes>
</pdfMap>
