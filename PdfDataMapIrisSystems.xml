		<area name="OrderItems" type="variable"   >
			<method name="ExtractTableBelowY" returns="rowSet">
				<parameters>
					<parameter name="pdfPath">C:\temp\PO3.pdf</parameter>
					<parameter name="x">4</parameter>
					<parameter name="scanBelowY">513.0</parameter>
					<parameter name="scanWidth">525.85</parameter>
					<parameter name="verticalGapBelow">28.0</parameter>
					
				</parameters>
			</method> 
			<rowSet rowCount="variable" methodName="ExtractTableBelowY" parent="PurchaseOrder"  >
				<row repeat="true" name="PurchaseOrderItem" operation="script">
					<script language="csharp">
						<![CDATA[
            // Your script to parse each line text content from the extracted table lines
            var parts = text.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
            return new {
              Item = parts.Length > 0 ? parts[0] : "",
              Code = parts.Length > 1 ? parts[1] : "",
              Qty = parts.Length > 2 ? parts[2] : "",
              UnitPrice = parts.Length > 3 ? parts[3] : "",
              LineTotal = parts.Length > 4 ? parts[4] : ""
            };
            ]]>
					</script>
					<columns>
						<Item />
						<Code />
						<Qty />
						<UnitPrice />
						<LineTotal />
					</columns>
				</row>
			</rowSet>
