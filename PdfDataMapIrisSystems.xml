<?xml version="1.0" encoding="utf-8" ?>
<pdfMap client="IrisSystems" document="PurchaseOrder">
	<earMarked>
		<area name="buyer" rectangle="36,601,269,72" parent="parties" returns="rowSet" >
			<parameters>
				<parameter name="pdfPath">C:\temp\PO3.pdf</parameter>
				<parameter name="x">4</parameter>
				<parameter name="scanBelowY">640.0</parameter>
				<parameter name="scanWidth">55.0</parameter>
				<parameter name="verticalGapBelow">18.0</parameter>
			</parameters>
			<rowSet>
				<!-- SIMPLE ROW: Direct copy from row index 0 -->
				<row index="0" name="name" operation="copy" />
				<!-- SCRIPT ROW: Split address on comma -->
				<row index="1" name="address" operation="script" parent="address">
					<marker value="," />
					<script language="csharp">
						<![CDATA[ var parts = text.Split(new[] { marker }, StringSplitOptions.None);
							return new {
							street = parts.Length > 0 ? parts[0].Trim() : "",
							city = parts.Length > 1 ? parts[1].Trim() : "",
							postalCode = parts.Length > 2 ? parts[2].Trim() : "",
							country = parts.Length > 3 ? parts[3].Trim() : ""};	]]>
					</script>
					<columns>
						<street />
						<City />
						<postalCode />
						<country />
					</columns>
				</row>
				<row index="2" name="contact" operation="script" parent="contact" >
					<input dataAttribute="Contact" />
					<marker value="|" />
					<script language="csharp">
						<![CDATA[
            var parts = text.Split(new[]{ marker }, StringSplitOptions.None);
            return new {
                phone = parts.Length > 0 ? parts[0].Trim() : "",
                email = parts.Length > 1 ? parts[1].Trim() : ""
        
            };
          ]]>
					</script>
					<columns>
						<email />
						<phone />
						<mobile />
						<other />
					</columns>
				</row>
			</rowSet>
		</area>
