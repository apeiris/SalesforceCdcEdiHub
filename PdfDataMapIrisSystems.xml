<?xml version="1.0" encoding="utf-8"?>
<pdfMap client="IrisSystems"
        document="PurchaseOrder"
        rootName="po"
        pdfSource="c:\\temp\\PO4.pdf">

	<po ponumber="scrape:x=505,scanBelowY=792,width=50,line2LineGap=60"
	    date    ="scrape:x=169,scanBelowY=760,width=48,line2LineGap=10"
	    status  ="scrape:x=169,scanBelowY=742,width=50,line2LineGap=10"
	    x12Model="850-4010">

		<parties>
			<!-- single value field-->
			<buyer name="scrape:x=47,scanBelowY=653,width=50,line2LineGap=10">
				<!--1. scrape  -->
				<!--2. runs script:SplitAddress-->
				<!--3. maps to multiple fields (street,city,postcode,country)  -->
				<address map="scrape:x=47,scanBelowY=635,width=50,line2LineGap=10 | script:SplitAddress | map:street,city,postcode,country | xpath:/po/parties/buyer/address/@map" />
			</buyer>
		</parties>
	</po>
	<!-- ♻ Central script library -->
	<script name="SplitAddress">
		<![CDATA[
		return value.Split(',', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
	</script>

</pdfMap>
