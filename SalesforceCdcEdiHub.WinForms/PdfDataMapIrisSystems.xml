<?xml version="1.0" encoding="utf-8"?>
<pdfMap client="IrisSystems"
        document="PurchaseOrder"
        rootName="po"
        pdfSource="c:\\temp\\PO4.pdf">
	

	<po ponumber="&lt;% ScrapePDF(x:505,scanBelowY:792,width:50,line2LineGap:60) %&gt;"
	    date	="&lt;%ScrapePDF(x:169,scanBelowY:760,width:48,line2LineGap:10) %&gt;"
	    status	="&lt;%ScrapePDF(x:169,scanBelowY:742,width:50,line2LineGap:10) %&gt;"
	    x12Model="850-4010">
		<address map ="&lt;% SplitAddress(ScrapePDF(x:299,scanBelowY:635,width:50,line2LineGap:10),new string[] {&quot;street&quot;,&quot;city,&quot;postcode&quot;,&quot;country&quot;})) %&gt;"  />


		<parties>
			<delivery date="&lt;%ScrapePDF(x:428,scanBelowY:752,width:100,line2LineGap:10) %&gt;"/>
			<buyer	  name="&lt;%ScrapePDF(x:47,scanBelowY:653,width:50,line2LineGap:10) %&gt;">
			<address map="&lt;%ScrapePDF(x:47,scanBelowY:635,width:50,line2LineGap:10)  | script:SplitAddress | map:street,city,postcode,country | xpath:/po/parties/buyer/address/@map &gt;"/>
			<contact map="&lt;%ScrapePDF(x:47,scanBelowY:615,width:50,line2LineGap:10) | script:SplitContact | map:tel,email | xpath:/po/parties/buyer/contact/@map &gt;"/>
			</buyer>
			<seller  name ="&lt;%ScrapePDF(x:299,scanBelowY:653,width:50,line2LineGap:10) %&gt; " >
				<address map ="&lt;%ScrapePDF(x:299,scanBelowY:635,width:50,line2LineGap:10) %&gt; | script:SplitAddress | map:street,city,postcode,country | xpath:/po/parties/buyer/address/@map" />
				<contact map ="&lt;%ScrapePDF(x:299,scanBelowY:615,width:50,line2LineGap:10) %&gt; | script:SplitContact | map:tel,email | xpath:/po/parties/buyer/contact/@map" />
			</seller>
		</parties>
		<po1loop>

			<loop name="PO1" fsm="&lt;% ScrapePDF(x:40,scanBelowY:501,width:515,line2LineGap:30),test(rootName:'po',elements:'line',attributes:'Item,Code,qty,unitPrice,Total'); %&gt;" />	
		</po1loop>
	</po>
	<!-- ♻ Central script library -->
	<scriptlib>
		<script name="SplitAddress">
			<![CDATA[
		return value.Split(',', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
		</script>
		<script name="SplitContact">
			<![CDATA[
		return value.Split('|', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
		</script>
	</scriptlib>


</pdfMap>
