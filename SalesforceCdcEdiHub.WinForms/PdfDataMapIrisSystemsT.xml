<?xml version="1.0" encoding="utf-8"?>
<pdfMap client="IrisSystems" document="PurchaseOrder" rootName="po"    pdfSource="c:\\temp\\PO4.pdf">
	<po>
			<address map="&lt;%  SplitAddress(ScrapePDF(x:47,scanBelowY:635,width:50,line2LineGap:10), new string[] {&quot;street&quot;, &quot;city&quot;, &quot;postcode&quot;, &quot;country&quot;}) %&gt;" />
	</po>
	<!-- ♻ Central script library -->
	<scriptlib>
		<script name="SplitAddress">
			<![CDATA[
		return value.Split(',', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
		</script>
		<script name="SplitContact">
			<![CDATA[
		return value.Split('|', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
		</script>
	</scriptlib>
</pdfMap>
