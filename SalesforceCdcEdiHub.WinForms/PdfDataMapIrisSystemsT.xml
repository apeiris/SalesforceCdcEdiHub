				<contact map="&lt;% Split(ScrapePDF(x:47,scanBelowY:615,width:50,line2LineGap:10),new string[]{&quot;telephone&quot;,&quot;email&quot;},delimiter:'|') %&gt;"/>

				</address>
			</buyer>
		</parties>
	</po>
