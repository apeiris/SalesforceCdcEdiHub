	<!-- ♻ Central script library -->
	<scriptlib>
		<script name="SplitAddress">
			<![CDATA[
		return value.Split(',', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
		</script>
		<script name="SplitContact">
			<![CDATA[
		return value.Split('|', StringSplitOptions.RemoveEmptyEntries)
		            .Select(x => x.Trim())
		            .ToList();
	]]>
		</script>
	</scriptlib>
